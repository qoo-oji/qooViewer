#!/bin/bash
# push される範囲のコミットメッセージと、追跡ファイル全体を最後にもう一度確かめる。
# 引数: $1 = リモート名、$2 = URL。標準入力に <local ref> <local sha> <remote ref> <remote sha> が並ぶ。
cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # 削除の push には中身が無い
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=$1"
    else
        range="$remote_sha..$local_sha"
    fi
    scripts/ci/check-private-terms.sh --require-terms --commits "$range" || status=1
done
scripts/ci/check-private-terms.sh --require-terms || status=1
exit $status
