<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.books</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>epub</string>
				<string>pdf</string>
				<string>cb7</string>
				<string>7z</string>
				<string>cbr</string>
				<string>rar</string>
				<string>cbz</string>
				<string>zip</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Comic Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<!--
			  Release は Default、Debug は Alternate(ビルド設定 QOO_DOCUMENT_HANDLER_RANK)。
			  Debug ビルドはバンドルIDが別(com.qooProject.qooViewer.debug)で保存データも別なので、
			  Finder で本をダブルクリックしたときに開くアプリの候補を普段使いのアプリから奪わないようにする
			  (docs/02「主要なビルド設定」参照)。
			-->
			<key>LSHandlerRank</key>
			<string>$(QOO_DOCUMENT_HANDLER_RANK)</string>
		</dict>
		<!--
		  フォルダをDockアイコンへドロップして開けるようにするための宣言(ユーザー要望)。
		  Dockは CFBundleDocumentTypes に宣言された型しか受け付けない。アプリ側の
		  application(_:open:) は元からフォルダも扱えるので、足りなかったのはこの宣言だけ。
		  - public.folder: パッケージ(.app 等)を含まない通常のフォルダ。public.directory だと
		    パッケージまで受け付けてしまうので使わない。
		  - LSHandlerRank None: 「開けるが既定のハンドラ候補にはならない」。Finderの
		    「このアプリケーションで開く」の既定候補やフォルダのダブルクリック先を乗っ取らないため。
		-->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
		<!--
		  画像ファイルを単体/複数選択でDockアイコンやウェルカム画面へドロップして開けるように
		  するための宣言(ユーザー要望)。上のFolderエントリと同じく、Dockは
		  CFBundleDocumentTypes に宣言された型しか受け付けない。
		  - LSItemContentTypes(public.image 等のUTI)ではなく CFBundleTypeExtensions を使う。
		    webp/avif はUTIでの取りこぼしが起こりうるのに対し、拡張子指定なら確実に拾えるため。
		    一覧は Services/ArchiveReading.swift の imageExtensions と一致させること
		    (片方だけ増やすと「Finderからは開けるがフォルダ走査では無視される」等の食い違いになる)。
		  - **同じdictにLSItemContentTypesを併記しないこと。** UTI側が優先されて拡張子側が
		    無視されるため。
		  - LSHandlerRank None: 「開けるが既定のハンドラ候補にはならない」。画像の既定アプリを
		    プレビュー.appから奪ってしまわないため(Folderエントリと同じ配慮)。
		-->
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>jpg</string>
				<string>jpeg</string>
				<string>png</string>
				<string>gif</string>
				<string>bmp</string>
				<string>webp</string>
				<string>heic</string>
				<string>tif</string>
				<string>tiff</string>
				<string>avif</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
		</dict>
	</array>
	<!--
	  自動アップデート(Sparkle 2)。理由と運用は docs/10「自動アップデート」、リリースの手順は docs/02「リリース」。
	  ここの値はセキュリティの前提なので、変えるときは AppUpdater.swift の UpdaterConfiguration・
	  scripts/ci/check-release-app.sh・UpdaterConfigurationTests も一緒に見直すこと(どれも同じ約束を確かめている)。

	  - QOOUpdaterEnabled: Release だけ YES(ビルド設定 QOO_UPDATER_ENABLED)。Debug はバンドルIDも保存データも
	    別のアプリなので、配布版の更新で置き換わってはいけない。アプリ側はこれが YES でなければ Sparkle を起動しない。
	  - SUFeedURL: 最新のリリースに添付した appcast.xml。HTTPS 以外は AppUpdater が受け付けない。
	    利用者の defaults に SUFeedURL を書かれても使わない(Sparkle は defaults の値を Info.plist より優先するので、
	    AppUpdater がデリゲートからこの値を返し、起動時に defaults の値を消す)。
	  - SUPublicEDKey: 更新の書庫と appcast の署名を確かめる EdDSA の公開鍵(generate_keys が出力する base64。2026-10-10 生成、
	    キーチェーンのアカウント名 qooProject)。秘密鍵は作者の Mac のキーチェーンにだけあり、リポジトリには絶対に入れない。
	    空のあいだはアップデーターを起動しない。
	  - SUVerifyUpdateBeforeExtraction: 書庫を展開する**前に** EdDSA の署名を確かめる。展開の処理そのものを
	    改ざんされた書庫にさらさない。このアプリは Developer ID で署名していないので、Sparkle の「Apple の署名で
	    鍵を差し替える」逃げ道も使えず、EdDSA の鍵だけが信頼の根になる(鍵をなくすと更新を配れない)。
	  - SURequireSignedFeed / SUSignedFeedFailureExpirationInterval = 0: appcast(版・リリースノート)にも署名を求め、
	    署名が合わない状態が続いても期限切れで受け入れる逃げ道を作らない(上と同じく鍵の差し替えはしない前提)。
	  - SUEnableInstallerLauncherService / SUEnableDownloaderService: サンドボックスのアプリのための XPC サービス。
	    Downloader を使うことで、アプリ本体に通信の entitlement を足さずに済む(Configurations/qooViewer.entitlements)。
	  - SUEnableSystemProfiling = NO / SUEnableJavaScript = NO: 既定と同じだが明示する。更新の確認で Mac の情報を
	    送らない・リリースノートでスクリプトを動かさない。
	  - SUEnableAutomaticChecks = YES: 既定で自動確認する(利用者の判断 2026-10-10)。実際の ON/OFF は環境設定
	    「一般」▸「アップデート」(AppPreferences.checksForUpdatesAutomatically)を AppUpdater が Sparkle へ流す。
	  - SUAllowsAutomaticUpdates = YES: 「自動でダウンロードしてインストール」を選べるかを、自動確認の ON/OFF に依らせない。
	    無いと Sparkle はこれを起動時の自動確認の値に固定し(アプリから ON/OFF を変えても計算し直さない)、自動確認 OFF で
	    起動した回は、途中で ON にしても「自動でインストール」の設定が次の起動まで効かなかった(AppUpdater.apply のコメント)。
	    自動でダウンロードするのは自動確認の中だけなので、自動確認が OFF の間は YES でも何も起きない。
	-->
	<key>QOOUpdaterEnabled</key>
	<string>$(QOO_UPDATER_ENABLED)</string>
	<key>SUFeedURL</key>
	<string>https://github.com/qoo-oji/qooViewer/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>o1xVHoagbIv9h8DA32KqtZ15bG1wLAEBjlZ3qHc08Fc=</string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>SURequireSignedFeed</key>
	<true/>
	<key>SUSignedFeedFailureExpirationInterval</key>
	<integer>0</integer>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableDownloaderService</key>
	<true/>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>SUEnableJavaScript</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
</dict>
</plist>
