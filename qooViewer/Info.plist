<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>epub</string>
				<string>pdf</string>
				<string>cb7</string>
				<string>7z</string>
				<string>cbr</string>
				<string>rar</string>
				<string>cbz</string>
				<string>zip</string>
			</array>
			<key>CFBundleTypeName</key>
			<string>Comic Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
		</dict>
		<!--
		  フォルダをDockアイコンへドロップして開けるようにするための宣言(ユーザー要望)。
		  Dockは CFBundleDocumentTypes に宣言された型しか受け付けない。アプリ側の
		  application(_:open:) は元からフォルダも扱えるので、足りなかったのはこの宣言だけ。
		  - public.folder: パッケージ(.app 等)を含まない通常のフォルダ。public.directory だと
		    パッケージまで受け付けてしまうので使わない。
		  - LSHandlerRank None: 「開けるが既定のハンドラ候補にはならない」。Finderの
		    「このアプリケーションで開く」の既定候補やフォルダのダブルクリック先を乗っ取らないため。
		-->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
