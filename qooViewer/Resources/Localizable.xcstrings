    "Controls how many pages before and after the current page are preloaded. A higher value makes page turning faster but uses more memory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls how many pages before and after the current page are preloaded. A higher value makes page turning faster but uses more memory."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のページの前後何ページ分をあらかじめ読み込んでおくかの設定です。多いほどページ送りが速くなりますが、メモリを多く使います。"
          }
        }
      }
    },
