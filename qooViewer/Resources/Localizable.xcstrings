    "0% leaves the panel exactly as it looks by default. 100% fills it with the color, which hides the frosted glass completely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% leaves the panel exactly as it looks by default. 100% fills it with the color, which hides the frosted glass completely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0%なら既定の見た目のままです。100%にすると色で塗りつぶされ、すりガラスは完全に隠れます。"
          }
        }
      }
    },
