    "“%@” can’t be renamed: names that begin with a dot “.” are reserved for the system." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” can’t be renamed: names that begin with a dot “.” are reserved for the system."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の名前を変更できません。「.」(ドット)で始まる名前はシステムだけが使用できます。"
          }
        }
      }
    },
    "“%@” changed while it was being copied, so the operation was stopped." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” changed while it was being copied, so the operation was stopped."
