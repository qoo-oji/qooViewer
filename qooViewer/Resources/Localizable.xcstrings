    "How long the pointer has to stay near the window edge before this part appears while it is hidden. In full screen the toolbar and progress bar are always hidden, so it applies there too." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How long the pointer has to stay near the window edge before this part appears while it is hidden. In full screen the toolbar and progress bar are always hidden, so it applies there too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隠しているあいだ、この部分が表示されるまでウインドウの端にカーソルを留めておく必要のある時間です。フルスクリーン表示中はツールバーとプログレスバーが常に隠れるため、そのときにも適用されます。"
          }
        }
      }
    },
