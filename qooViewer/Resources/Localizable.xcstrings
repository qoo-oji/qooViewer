    "When off, qooViewer stays in the Dock after closing windows, like most other Mac apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, qooViewer stays in the Dock after closing windows, like most other Mac apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OFFのときは、他の多くのMacアプリと同様にウインドウを閉じてもDockに残ります。"
          }
        }
      }
    },
    "When qooViewer Already Has a Book Open": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When qooViewer Already Has a Book Open"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "qooViewerが既に本を表示している場合"
          }
        }
      }
    },
    "When turned on, page turning on the trackpad uses the “swipe between pages” gesture (a left/right flick) instead of two-finger vertical scrolling; two-finger vertical scrolling on the trackpad is ignored. The physical scroll wheel is not affected and always turns pages by scrolling.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When turned on, page turning on the trackpad uses the “swipe between pages” gesture (a left/right flick) instead of two-finger vertical scrolling; two-finger vertical scrolling on the trackpad is ignored. The physical scroll wheel is not affected and always turns pages by scrolling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、トラックパッドでのページ送りは2本指の縦スクロールではなく、「ページ間をスワイプ」ジェスチャー(左右へのフリック)を使うようになります。トラックパッドの2本指の縦スクロールは無視されます。物理的なスクロールホイールには影響せず、これまでどおりスクロールでページ送りできます。"
          }
        }
      }
    },
    "White": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "White"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "白"
          }
        }
      }
    },
    "You can also open by dragging and dropping here": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also open by dragging and dropping here"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにドラッグ&ドロップしても開けます"
          }
        }
      }
    },
    "qooViewer keeps a small amount of data for each book you've opened (last read page, display settings, and bookmarks). Once you've opened more books than this number, the oldest ones are automatically forgotten so this data doesn't keep growing indefinitely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "qooViewer keeps a small amount of data for each book you've opened (last read page, display settings, and bookmarks). Once you've opened more books than this number, the oldest ones are automatically forgotten so this data doesn't keep growing indefinitely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "qooViewerは、開いたことのある本ごとに、最後に読んだページ・表示設定・ブックマークなどのわずかなデータを保存します。この数を超えて本を開くと、データが際限なく増え続けないよう、最も古いものから自動的に削除されます。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
