    "Use @author for the author, @title for the title, and @ignore for text to skip. Formats are matched against the file name without its extension, from top to bottom, and the first one that matches wins — drag to reorder. Excluded text is removed before matching." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use @author for the author, @title for the title, and @ignore for text to skip. Formats are matched against the file name without its extension, from top to bottom, and the first one that matches wins — drag to reorder. Excluded text is removed before matching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@author は著者名、@title はタイトル、@ignore は読み飛ばす任意の文字列を表します。拡張子を除いたファイル名と上から順に照合し、最初に一致したフォーマットを採用します(ドラッグで並べ替えられます)。除外文字列は照合の前に削られます。"
          }
        }
      }
    },
    "Use this only when your saved data is damaged and will not load — for example, after an app update. It deletes everything and starts over from a clean state." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this only when your saved data is damaged and will not load — for example, after an app update. It deletes everything and starts over from a clean state."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存したデータが壊れて読み込めなくなったとき(アプリの更新後など)にだけ使ってください。\nすべてを削除して、まっさらな状態からやり直します。"
          }
        }
      }
    },
    "Used the first time a book is opened. Changing it later affects only that book." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used the first time a book is opened. Changing it later affects only that book."
