    },
    "Archive" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブ"
          }
        }
      }
    },
    "Archives found inside the books open in this launch that were too large for the “Nested archives kept in memory” setting and had to be written out to be read. Only the ones in use are kept; they are removed as you move on, when the book is closed, and when the app quits." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives found inside the books open in this launch that were too large for the “Nested archives kept in memory” setting and had to be written out to be read. Only the ones in use are kept; they are removed as you move on, when the book is closed, and when the app quits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この起動で開いた本の中で見つかった書庫のうち、設定「メモリに残しておく入れ子の書庫」より大きく、読むためにファイルへ書き出す必要があったものです。使っているぶんだけを残し、読み進めるにつれて・本を閉じたとき・アプリを終了したときに削除されます。"
          }
        }
      }
    },
    "Archives found inside this book that are open right now, against the “Nested archives kept in memory” setting. Every format is read directly from memory; an archive larger than the setting is written to a temporary file instead, which appears under On Disk ▸ Temporary files." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives found inside this book that are open right now, against the “Nested archives kept in memory” setting. Every format is read directly from memory; an archive larger than the setting is written to a temporary file instead, which appears under On Disk ▸ Temporary files."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この本の中で見つかった書庫のうち、いま開いているもの。分母は設定「メモリに残しておく入れ子の書庫」です。形式を問わずメモリから直接読みますが、設定より大きい書庫は一時ファイルに書き出して開き、そちらは「ディスク上」の「一時ファイル」に出ます。"
          }
        }
      }
    },
    "Archives, PDF and EPUB files, and folders of images can be used as books." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives, PDF and EPUB files, and folders of images can be used as books."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書庫・PDF・EPUB のファイルと、画像の入ったフォルダが本になります。"
          }
        }
      }
    },
    "Archives, PDF and EPUB files, and folders of images can be used as books. A folder of books adds the books in it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archives, PDF and EPUB files, and folders of images can be used as books. A folder of books adds the books in it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書庫・PDF・EPUB のファイルと、画像の入ったフォルダが本になります。本が並んだフォルダを選ぶと、その中の本が入ります。"
          }
        }
      }
    },
    "Are you sure you want to delete “%@”?" : {
