      }
    },
    "“%@” couldn’t be read. It may be damaged, encrypted, or compressed with a method qooViewer doesn’t support." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” couldn’t be read. It may be damaged, encrypted, or compressed with a method qooViewer doesn’t support."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を読めませんでした。壊れているか、暗号化されているか、qooViewer が対応していない方式で圧縮されている可能性があります。"
          }
        }
      }
    },
    "“%@” couldn’t be restored because it was moved, renamed or replaced." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” couldn’t be restored because it was moved, renamed or replaced."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は移動・名前の変更・置き換えが行われたため、元に戻せませんでした。"
          }
        }
      }
    },
    "“%@” couldn’t be set as the application that always opens the items." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” couldn’t be set as the application that always opens the items."
