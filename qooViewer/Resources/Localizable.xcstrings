          }
        }
      }
    },
    "The file extension given to archives made with Compress. Both are ordinary ZIP archives; .cbz is recognized as a comic book by qooViewer and other comic readers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file extension given to archives made with Compress. Both are ordinary ZIP archives; .cbz is recognized as a comic book by qooViewer and other comic readers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「圧縮」で作るファイルに付ける拡張子です。どちらも中身は普通の ZIP です。.cbz にすると、qooViewer やほかの漫画ビューアが本として扱います。"
          }
        }
      }
    },
