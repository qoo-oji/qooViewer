    "Always shows page 1, no matter how far you read.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always shows page 1, no matter how far you read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回どこまで読んだかに関わらず、1ページ目を表示します。"
          }
        }
      }
    },
    "An action can have several keys. A key can be assigned to only one action.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An action can have several keys. A key can be assigned to only one action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの操作に複数のキーを割り当てられます。1つのキーを割り当てられる操作は1つだけです。"
          }
        }
      }
    },
    "An image whose width ÷ height is at least this value is shown on its own instead of being paired into a spread.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An image whose width ÷ height is at least this value is shown on its own instead of being paired into a spread."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横幅÷高さがこの値以上の画像は、見開きに組まずに1ページとして表示します。"
          }
        }
      }
    },
    "Anywhere": {
      "localizations": {
