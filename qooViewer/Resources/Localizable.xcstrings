    "Setting “%1$@” also changes %2$lld books you did not pick. %3$lld of the books you picked change: %4$lld gain a series and %5$lld lose one." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setting “%1$@” also changes %2$lld books you did not pick. %3$lld of the books you picked change: %4$lld gain a series and %5$lld lose one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」にすると、選択していない %2$lld 冊も変わります(選択した本で変わるのは %3$lld 冊。新しくシリーズが付く %4$lld 冊、外れる %5$lld 冊)"
          }
        }
      }
    },
    "Settings here override Keyboard and Mouse while this display mode is active. Anything left unassigned keeps working as set there." : {
