    "Regular expressions that match the volume marker at the end of the title. The first capture group becomes the volume number (full-width digits are converted to half-width). The text before the match becomes the series name." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regular expressions that match the volume marker at the end of the title. The first capture group becomes the volume number (full-width digits are converted to half-width). The text before the match becomes the series name."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルの末尾にある巻数表記に一致する正規表現です。最初のキャプチャグループが巻数になります(全角数字は半角に変換されます)。一致した部分より前がシリーズ名になります。"
          }
