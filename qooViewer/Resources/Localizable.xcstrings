    "Applies only when qooViewer already has a book open. From the welcome screen, a book always opens in the current window." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies only when qooViewer already has a book open. From the welcome screen, a book always opens in the current window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに本を開いているときだけ適用されます。\nウェルカム画面からは、常に現在のウインドウで開きます。"
          }
        }
      }
    },
    "Applies to a physical mouse wheel only. Trackpad scrolling is unchanged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to a physical mouse wheel only. Trackpad scrolling is unchanged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理マウスのホイールにだけ効きます。\nトラックパッドのスクロールは変わりません。"
          }
        }
      }
    },
    "Applies to Go to Next/Previous Book and to File ▸ Open File in Same Folder. Folder books and file books are then visited in the order shown in the panel, instead of separately. When off, books follow name order." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to Go to Next/Previous Book and to File ▸ Open File in Same Folder. Folder books and file books are then visited in the order shown in the panel, instead of separately. When off, books follow name order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次の本へ」「前の本へ」と、ファイルメニューの「同じフォルダのファイルを開く」に効きます。\nフォルダの本とファイルの本を分けずに、パネルに表示されている順で行き来するようになります。\nOFFのときは名前順です。"
          }
        }
      }
    },
    "Applies to the page list only." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the page list only."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ一覧にのみ適用されます。"
          }
        }
      }
    },
    "Applies to thumbnails in the page list, the side panel's page mode, the bookmark editor, and the export windows." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to thumbnails in the page list, the side panel's page mode, the bookmark editor, and the export windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ一覧、サイドパネルのページモード、ブックマーク・レイアウトの編集、書き出しウインドウのサムネイルに適用されます。"
          }
        }
      }
    },
    "Apply" : {
      "localizations" : {
