    "If your favorites, bookmarks, or reading history ever become corrupted or fail to load (for example, after an app update), use this to permanently delete all of it and start fresh." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your favorites, bookmarks, or reading history ever become corrupted or fail to load (for example, after an app update), use this to permanently delete all of it and start fresh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入り・ブックマーク・読書履歴が破損したり読み込めなくなったりした場合(アプリの更新後など)、これを使ってすべてを完全に削除し、まっさらな状態からやり直せます。"
          }
        }
      }
    },
