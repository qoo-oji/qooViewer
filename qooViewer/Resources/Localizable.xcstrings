    "Applies when opening a file from Finder (e.g. by double-clicking, or “Open With”) while qooViewer already has a book open.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies when opening a file from Finder (e.g. by double-clicking, or “Open With”) while qooViewer already has a book open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "qooViewerが既に本を表示している状態で、Finderからファイルを開いた場合(ダブルクリックや「このアプリケーションで開く」など)に適用されます。"
          }
        }
      }
    },
