          }
        }
      }
    },
    "“%1$@” was copied to the destination, but the original couldn’t be removed, so both were kept. %2$@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” was copied to the destination, but the original couldn’t be removed, so both were kept. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は移動先へコピーしましたが、元の項目を削除できなかったため、両方を残しました。%2$@"
          }
        }
      }
    },
    "“%1$@” was replaced, but the original couldn’t be moved to the Trash. It was kept as the hidden item “%2$@” in the same folder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” was replaced, but the original couldn’t be moved to the Trash. It was kept as the hidden item “%2$@” in the same folder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」を置き換えましたが、元の項目をゴミ箱に入れられませんでした。同じフォルダの中に、隠し項目「%2$@」として残っています。"
          }
        }
      }
    },
    "“%1$@” would expand to more than %2$@, so it wasn’t extracted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
