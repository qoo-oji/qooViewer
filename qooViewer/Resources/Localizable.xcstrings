          }
        }
      }
    },
    "qooViewer detected that this book's files may have changed since its saved layout settings (reading direction, page order, single/spread page settings) were recorded. Keep the existing settings, or discard them and start fresh?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "qooViewer detected that this book's files may have changed since its saved layout settings (reading direction, page order, single/spread page settings) were recorded. Keep the existing settings, or discard them and start fresh?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この本のファイルが、レイアウト設定(読み方向・ページ順・単独/見開きページの設定)を記録した時点から変わっている可能性があります。既存の設定を維持しますか、それとも破棄してやり直しますか?"
          }
        }
      }
    },
    "qooViewer doesn't have permission to check this location, so it can't tell whether the file still exists. Granting access to the folder in Settings › Access, or connecting the volume, will let it check." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "qooViewer doesn't have permission to check this location, so it can't tell whether the file still exists. Granting access to the folder in Settings › Access, or connecting the volume, will let it check."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この場所を確認する権限が無いため、ファイルが残っているかどうかを判定できません。環境設定の「アクセス権」でフォルダを許可するか、ボリュームを接続すると判定できるようになります。"
          }
        }
      }
    },
    "qooViewer doesn't have permission to show the files in this folder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "qooViewer doesn't have permission to show the files in this folder."
          }
