    },
    "Keeps the “!” of “Garden of the Moon!” in the series name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps the “!” of “Garden of the Moon!” in the series name"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「月の庭!」の「!」をシリーズ名に含めます"
          }
        }
      }
    },
    "Kept narrower than the list for ordinary digits on purpose: a kanji numeral with nothing in front of it cannot be told from an ordinary word (三人の夜, 十字架). Add 月 here and 三月 becomes volume 3." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kept narrower than the list for ordinary digits on purpose: a kanji numeral with nothing in front of it cannot be told from an ordinary word (三人の夜, 十字架). Add 月 here and 三月 becomes volume 3."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "算用数字の一覧より**わざと狭く**してあります。前に「第」などが付かない漢数字は、ふつうの言葉と見分けが付きません(「三人の夜」「十字架」)。ここに「月」を足すと「三月」が 3 巻になります。"
          }
        }
      }
    },
