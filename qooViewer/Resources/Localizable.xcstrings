          }
        }
      }
    },
    "This permanently deletes every layout setting (reading direction, page order, single/spread page settings) in this book. This cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes every layout setting (reading direction, page order, single/spread page settings) in this book. This cannot be undone."
