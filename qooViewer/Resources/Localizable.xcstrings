        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリがディスクに保存しているもの全体(~/Library/Containers 内)です。"
          }
        }
      }
    },
    "Everything you've added or edited here will be replaced with the defaults. This can't be undone." : {
      "localizations" : {
