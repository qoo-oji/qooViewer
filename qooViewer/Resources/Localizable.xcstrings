    "Decoded page images kept in memory, against the “Page images kept in memory” setting." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decoded page images kept in memory, against the “Page images kept in memory” setting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリに残しているデコード済みのページ画像と、環境設定「メモリに残しておくページ画像」の上限です。"
          }
        }
      }
    },
    "Decoded pages near the one you are reading stay in memory so that turning back is instant. This is the limit per open book. Larger values turn pages faster after going back; smaller values use less memory." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decoded pages near the one you are reading stay in memory so that turning back is instant. This is the limit per open book. Larger values turn pages faster after going back; smaller values use less memory."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読んでいるページの前後のページをメモリに残しておき、戻ったときに即座に表示できるようにします。\n開いている本1冊あたりの上限です。\n大きくすると戻ったときのページ送りが速くなり、小さくするとメモリの使用量が減ります。"
          }
        }
      }
    },
