            "value" : "次のコレクションは中の本が全部なくなるため、コレクションごと削除されます:"
          }
        }
      }
    },
    "Every book opens in a private window — nothing is recorded: no reading position, bookmarks, favorites, layouts, or history. Use File ▸ New Normal Window when you do want a book to be remembered." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every book opens in a private window — nothing is recorded: no reading position, bookmarks, favorites, layouts, or history. Use File ▸ New Normal Window when you do want a book to be remembered."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての本がシークレットウインドウで開き、読書位置・ブックマーク・お気に入り・レイアウト・履歴のいずれも記録されません。\n記録を残したいときは、ファイルメニューの「新規ノーマルウインドウ」を使ってください。"
          }
        }
      }
    },
    "Every book you picked gets this value. Empty clears the field." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every book you picked gets this value. Empty clears the field."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ本すべてがこの値になります。空にすると欄を空にします。"
          }
        }
      }
    },
    "Every book you picked gets this volume. Books with no series name are left alone. Empty clears the volume." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every book you picked gets this volume. Books with no series name are left alone. Empty clears the volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ本すべてがこの巻になります。シリーズ名の無い本は変わりません。空にすると巻を消します。"
          }
        }
      }
    },
    "Every book you picked is put in this series. Empty removes them from their series." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every book you picked is put in this series. Empty removes them from their series."
