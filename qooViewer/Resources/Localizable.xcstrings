    "Kavita reads Volume as the volume number, but Komga appends it to the series name, which can split a series into one series per volume." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kavita reads Volume as the volume number, but Komga appends it to the series name, which can split a series into one series per volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kavita は Volume を巻数として読みますが、Komga はシリーズ名に連結するため、1巻ごとに別のシリーズへ分かれてしまうことがあります。"
          }
        }
      }
    },
