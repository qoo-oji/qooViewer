    },
    "Some rules would rename items that are already in their folders. They won’t rename anything until you check the changes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some rules would rename items that are already in their folders. They won’t rename anything until you check the changes."
          }
        },
        "ja" : {
