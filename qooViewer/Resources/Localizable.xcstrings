    "Regular expressions for text to remove from the file name before matching it against the file name formats — for example a year in parentheses, or a completion marker.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regular expressions for text to remove from the file name before matching it against the file name formats — for example a year in parentheses, or a completion marker."
