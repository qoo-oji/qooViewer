      }
    },
    "Every book opens in a private window — nothing is recorded: no reading position, bookmarks, favorites, layouts, or history. Use File ▸ New Normal Window when you do want a book to be remembered." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every book opens in a private window — nothing is recorded: no reading position, bookmarks, favorites, layouts, or history. Use File ▸ New Normal Window when you do want a book to be remembered."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての本がシークレットウインドウで開き、読書位置・ブックマーク・お気に入り・レイアウト・履歴のいずれも記録されません。\n記録を残したいときは、ファイルメニューの「新規ノーマルウインドウ」を使ってください。"
          }
        }
      }
    },
    "Everything else in the app’s container: preferences, saved window state, logs." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything else in the app’s container: preferences, saved window state, logs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテナ内のその他のもの(環境設定、ウインドウの状態、ログなど)です。"
          }
        }
      }
    },
    "Everything the app stores on disk, in ~/Library/Containers." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything the app stores on disk, in ~/Library/Containers."
