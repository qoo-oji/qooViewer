    "Use @author for the author, @title for the title, and @ignore for text to skip. Formats are matched against the file name without its extension, from top to bottom, and the first one that matches wins — drag to reorder. Excluded text is removed before matching." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use @author for the author, @title for the title, and @ignore for text to skip. Formats are matched against the file name without its extension, from top to bottom, and the first one that matches wins — drag to reorder. Excluded text is removed before matching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@author は著者名、@title はタイトル、@ignore は読み飛ばす任意の文字列を表します。拡張子を除いたファイル名と上から順に照合し、最初に一致したフォーマットを採用します(ドラッグで並べ替えられます)。除外文字列は照合の前に削られます。"
          }
        }
      }
    },
    "Use a Separate Appearance for Private Windows" : {
      "localizations" : {
        "en" : {
