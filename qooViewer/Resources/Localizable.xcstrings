    "Every book opens in a private window — nothing is recorded: no reading position, bookmarks, favorites, layouts, or history. Use File ▸ New Normal Window when you do want a book to be remembered.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every book opens in a private window — nothing is recorded: no reading position, bookmarks, favorites, layouts, or history. Use File ▸ New Normal Window when you do want a book to be remembered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての本がシークレットウインドウで開き、読書位置・ブックマーク・お気に入り・レイアウト・履歴のいずれも記録されません。記録を残したいときは、ファイルメニューの「新規ノーマルウインドウ」を使ってください。"
          }
        }
      }
    },
