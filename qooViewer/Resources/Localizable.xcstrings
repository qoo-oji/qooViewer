          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面のすべての設定を初期設定に戻します(サムネイルのディスクキャッシュはOFFになり、削除されます)。\nほかの画面の設定と、お気に入り・ブックマーク・読書位置には影響しません。"
          }
        }
      }
    },
