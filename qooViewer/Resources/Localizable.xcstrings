    "Overwrite Existing File?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overwrite Existing File?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のファイルを上書きしますか?"
          }
        }
      }
    },
    "Overwrite replaces existing data for the books mentioned in the file. Merge only adds what's missing, without changing anything that already exists. Ignore skips that category entirely." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overwrite replaces existing data for the books mentioned in the file. Merge only adds what's missing, without changing anything that already exists. Ignore skips that category entirely."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「上書き」はファイルに含まれる本の既存データを置き換えます。「マージ」は既存のデータを変更せず、足りないものだけを追加します。「無視」はその種類を読み込みません。"
          }
        }
      }
    },
    "Page" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページ"
          }
        }
      }
    },
    "Page %lld of this PDF has no embedded image, so it can't be exported." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page %lld of this PDF has no embedded image, so it can't be exported."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPDFの%lldページ目には埋め込み画像がないため、書き出せません。"
          }
        }
      }
    },
    "Page %lld of this PDF uses an image format other than JPEG or Flate (lossless), which isn't supported for export." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Page %lld of this PDF uses an image format other than JPEG or Flate (lossless), which isn't supported for export."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPDFの%lldページ目はJPEGでもFlate(可逆圧縮)でもない画像形式のため、書き出しに対応していません。"
          }
        }
      }
    },
