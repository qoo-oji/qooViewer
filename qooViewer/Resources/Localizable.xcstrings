    "All favorites, bookmarks, layout settings, and reading history have been deleted. qooViewer will now quit — please reopen it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All favorites, bookmarks, layout settings, and reading history have been deleted. qooViewer will now quit — please reopen it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのお気に入り・ブックマーク・レイアウト設定・読書履歴を削除しました。qooViewerはこのあと終了します。もう一度起動し直してください。"
          }
        }
      }
    },
