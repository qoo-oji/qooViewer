    },
    "Physical disk reads (orange) and writes (purple). Reads served from the system’s file cache are not counted, matching Activity Monitor’s Disk tab." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Physical disk reads (orange) and writes (purple). Reads served from the system’s file cache are not counted, matching Activity Monitor’s Disk tab."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理的なディスクの読み込み(オレンジ)と書き込み(紫)です。システムのファイルキャッシュから読めた分は数えません(アクティビティモニタの「ディスク」タブと同じ)。"
          }
        }
      }
    },
    "Pick a book in the list and its details appear here. Pick several and you can change them together." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a book in the list and its details appear here. Pick several and you can change them together."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧で本を選ぶと、ここに詳細が表示されます。複数選択すると、まとめて書き換えられます。"
          }
        }
      }
    },
    "Pick a color from the palette, then fine-tune it with the RGB sliders." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a color from the palette, then fine-tune it with the RGB sliders."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パレットから色を選び、RGBのスライダーで微調整します。"
          }
        }
      }
    },
    "Pick what is going wrong and the settings that bear on it appear on the right." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick what is going wrong and the settings that bear on it appear on the right."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "困っていることを選ぶと、それに効く設定が右に出ます。"
          }
        }
      }
    },
    "Pictures of books, images, videos and folders shown in the file browser's icon view, so a folder you have viewed before shows them without reading the books again. Kept under the limit shown, oldest first; you can turn it off or delete it in Settings ▸ Cache." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures of books, images, videos and folders shown in the file browser's icon view, so a folder you have viewed before shows them without reading the books again. Kept under the limit shown, oldest first; you can turn it off or delete it in Settings ▸ Cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルブラウザのアイコン表示に出す本・画像・動画・フォルダの絵。一度表示したフォルダでは本を読み直さずに出せます。表示している上限の中に収まるよう、古いものから削除されます。環境設定 ▸ キャッシュでオフにしたり削除したりできます。"
          }
        }
      }
    },
    "Pictures shown in the file browser's icon view, against the maximum size above. Deleting them does not change any file; the pictures are simply made again the next time a folder is shown." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pictures shown in the file browser's icon view, against the maximum size above. Deleting them does not change any file; the pictures are simply made again the next time a folder is shown."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルブラウザのアイコン表示に出す絵の使用量です(上限は上の最大容量)。削除してもファイルは何も変わらず、次にフォルダを表示したときに絵を作り直すだけです。"
          }
        }
      }
    },
