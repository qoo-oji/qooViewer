    "This permanently deletes every bookmark and every layout setting (reading direction, page order, single/spread page settings) in this book. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes every bookmark and every layout setting (reading direction, page order, single/spread page settings) in this book. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本のすべてのブックマークとすべてのレイアウト設定(読み方向・ページ順・単独/見開きページの設定)を完全に削除します。この操作は取り消せません。"
          }
        }
      }
    },
    "This permanently deletes every bookmark in this book. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes every bookmark in this book. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本のすべてのブックマークを完全に削除します。この操作は取り消せません。"
          }
        }
      }
    },
    "This permanently deletes every favorite, favorite folder, bookmark, page layout setting, and saved reading position (last page, display settings) for every book. This cannot be undone, and qooViewer will quit immediately afterward.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes every favorite, favorite folder, bookmark, page layout setting, and saved reading position (last page, display settings) for every book. This cannot be undone, and qooViewer will quit immediately afterward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのお気に入り・お気に入りフォルダ・ブックマーク・レイアウト設定、およびすべての本の保存済みの読書位置(最後に読んだページ・表示設定)を完全に削除します。この操作は元に戻せません。実行後、qooViewerはただちに終了します。"
          }
        }
      }
    },
    "This permanently deletes every layout setting (reading direction, page order, single/spread page settings) in this book. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes every layout setting (reading direction, page order, single/spread page settings) in this book. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本のすべてのレイアウト設定(読み方向・ページ順・単独/見開きページの設定)を完全に削除します。この操作は取り消せません。"
          }
        }
      }
    },
    "This permanently deletes the favorites, bookmarks, page layout settings, metadata, and reading history qooViewer has saved for this. The file itself is not touched. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the favorites, bookmarks, page layout settings, metadata, and reading history qooViewer has saved for this. The file itself is not touched. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本について qooViewer が保存しているお気に入り・ブックマーク・レイアウト設定・メタデータ・読書履歴を完全に削除します。ファイル自体には触れません。この操作は取り消せません。"
          }
        }
      }
    },
    "This recalculates the layout of the entire book, based on the page (or spread) currently displayed. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recalculates the layout of the entire book, based on the page (or spread) currently displayed. This cannot be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在表示しているページ(または見開き)を基準に、本全体のレイアウトを再計算します。この操作は取り消せません。"
          }
        }
      }
    },
    "This removes every entry from the File menu's Open Recent and from the side panel's History mode. Your files are not touched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes every entry from the File menu's Open Recent and from the side panel's History mode. Your files are not touched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルメニューの「最近開いたファイル」と、サイドパネルの履歴モードから、すべての項目を取り除きます。ファイルそのものには手を触れません。"
          }
        }
      }
    },
    "This removes every entry from the History list and from the File menu's Open Recent. Your files are not touched.": {
      "localizations": {
        "en": {
          "stringUnit": {
