    "Keep out of every series" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep out of every series"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シリーズに入れない"
          }
        }
      }
    },
    "Keep the three lists in the same order (上/中/下, 上巻/中巻/下巻, 前編/中編/後編): a first volume that had no number is written with the word that matches the set — 後編 gives 前編." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the three lists in the same order (上/中/下, 上巻/中巻/下巻, 前編/中編/後編): a first volume that had no number is written with the word that matches the set — 後編 gives 前編."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 つの一覧は同じ並びで書いてください(上/中/下、上巻/中巻/下巻、前編/中編/後編)。番号の無い 1 巻目を推定したとき、そろいの語で書きます(「後編」があれば「前編」)。"
          }
        }
      }
    },
    "Keep them together" : {
      "extractionState" : "manual",
      "localizations" : {
