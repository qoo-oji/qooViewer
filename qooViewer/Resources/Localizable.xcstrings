    },
    "Lays out the whole book the same way “Auto-Layout Based on Current View” does, using the first page as the starting point. Books that already have layout data — including EPUB and PDF, whose layout is imported the first time you open them — are left alone." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lays out the whole book the same way “Auto-Layout Based on Current View” does, using the first page as the starting point. Books that already have layout data — including EPUB and PDF, whose layout is imported the first time you open them — are left alone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「現在の表示を基準に自動でレイアウト」と同じ計算を、1ページ目を起点にして本全体に行います。\nレイアウトの保存データが既にある本には何もしません(EPUB・PDFは初めて開いた時点でファイル側のレイアウトを読み込むため、これに含まれます)。"
          }
        }
      }
    },
