        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに本を開いているときだけ適用されます。\nホームからは、常に現在のウインドウで開きます。"
          }
        }
      }
    },
    "Applies to a physical mouse wheel only. Trackpad scrolling is unchanged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to a physical mouse wheel only. Trackpad scrolling is unchanged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "物理マウスのホイールにだけ効きます。\nトラックパッドのスクロールは変わりません。"
          }
        }
      }
    },
    "Applies to Go to Next/Previous Book and to File ▸ Open File in Same Folder. Folder books and file books are then visited in the order shown in the panel, instead of separately. When off, books follow name order." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to Go to Next/Previous Book and to File ▸ Open File in Same Folder. Folder books and file books are then visited in the order shown in the panel, instead of separately. When off, books follow name order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「次の本へ」「前の本へ」と、ファイルメニューの「同じフォルダのファイルを開く」に効きます。\nフォルダの本とファイルの本を分けずに、パネルに表示されている順で行き来するようになります。\nOFFのときは名前順です。"
          }
        }
      }
    },
    "Applies to qooViewer only, whatever the system Light/Dark setting is. The viewer's background color is a separate setting." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to qooViewer only, whatever the system Light/Dark setting is. The viewer's background color is a separate setting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムのライト/ダークの設定に関わらず、qooViewerだけをこの外観にします。ビューアの背景色は別の設定です。"
          }
        }
      }
    },
    "Applies to the file name, the page number, and the location shown above thumbnails that live in a folder inside the book." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the file name, the page number, and the location shown above thumbnails that live in a folder inside the book."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル名とページ番号、および書庫の中のフォルダにある画像でサムネイルの上に表示される場所に適用されます。"
          }
        }
      }
    },
    "Applies to the folder browser at the top of the side panel. The book contents list below it always follows the book's page order." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the folder browser at the top of the side panel. The book contents list below it always follows the book's page order."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドパネル上段のフォルダブラウザに適用されます。\n下段の本の中身の一覧は、常に本のページ順に従います。"
          }
        }
      }
    },
    "Applies to the page list only." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to the page list only."
