            "value" : "同じシリーズの本の先頭に漢数字が並ぶとき"
          }
        }
      }
    },
    "When the cache would grow past this size, the pictures you looked at longest ago are deleted first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When the cache would grow past this size, the pictures you looked at longest ago are deleted first."
